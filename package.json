{
  "name": "fish-harness",
  "version": "1.0.0",
  "description": "Fish Harness — premium AI coding harness: desktop app, IDE mode and terminal CLI.",
  "type": "module",
  "main": "desktop/main.cjs",
  "bin": {
    "fish": "bin/fish.js"
  },
  "scripts": {
    "dev": "concurrently -k -n server,ui -c cyan,magenta \"node bin/fish.js serve --no-open --port 4317\" \"vite --config ui/vite.config.js\"",
    "build": "vite build --config ui/vite.config.js",
    "serve": "node bin/fish.js serve",
    "desktop": "npm run build && electron .",
    "desktop:dev": "electron .",
    "cli": "node bin/fish.js",
    "dist": "npm run build && electron-builder --win --x64"
  },
  "build": {
    "appId": "dev.fishharness.app",
    "productName": "Fish Harness",
    "files": [
      "bin/**",
      "core/**",
      "server/**",
      "desktop/**",
      "ui/dist/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "desktop/icon.png"
    }
  },
  "engines": {
    "node": ">=20.10"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "fast-glob": "^3.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "vite": "^8.3.4"
  }
}
